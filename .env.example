# Environment Variables Template
# Copy this file to .env.local and add your actual values
# NEVER commit .env.local or any .env files with real values!

# ============================================
# API KEYS & SECRETS
# ============================================

# Google Analytics (Optional)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Maps API (Optional - for advanced maps features)
# VITE_GOOGLE_MAPS_API_KEY=your_api_key_here

# Google Places API key — powers live Reviews on the homepage.
# Steps:
#   1. console.cloud.google.com → enable "Places API (New)"
#   2. Create API key, restrict by HTTP referrer (your prod domain + localhost)
#   3. Restrict to Places API only
# When empty, the Reviews section shows curated fallback reviews.
# VITE_GOOGLE_PLACES_API_KEY=your_places_api_key_here

# Facebook Pixel (Optional)
# VITE_FACEBOOK_PIXEL_ID=your_pixel_id_here

# Rating widget — destination email for low-rating private feedback (mailto).
# Falls back to a placeholder if unset; replace with your real inbox.
# VITE_FEEDBACK_EMAIL=info@your-restaurant.com

# Newsletter signup POST endpoint (Formspree, Buttondown, a Supabase edge
# function, …). It receives { email, lang, source }. When unset, the signup
# form falls back to a pre-filled WhatsApp message so it still works with no
# backend.
# VITE_NEWSLETTER_ENDPOINT=https://formspree.io/f/your_form_id

# Live Instagram feed JSON endpoint (e.g. Behold.so, EmbedSocial, or a small
# serverless proxy to the Instagram Graph API). Returns an array of post
# objects ({ media_url, permalink }) or plain image URLs. When unset or
# unreachable, the gallery shows the bundled photos instead.
# VITE_INSTAGRAM_FEED_URL=https://feeds.behold.so/your_feed_id

# Owner console PIN for /admin (sold-out toggle + price overrides).
# NOTE: this ships to the client, so it only deters casual access — keep the
# /admin URL private. Defaults to 1234 when unset.
# VITE_ADMIN_PIN=1234

# Staff PIN for adding loyalty-card stamps at the counter (/loyalty).
# Same caveat as above. Defaults to 1234 when unset.
# VITE_STAFF_PIN=1234

# Any third-party service API keys
# VITE_SERVICE_API_KEY=your_key_here

# ============================================
# CONFIGURATION
# ============================================

# Environment (development | production)
VITE_APP_ENV=production

# API Base URL (if you add backend later)
# VITE_API_BASE_URL=https://api.example.com

# ============================================
# SECURITY NOTES
# ============================================
# 1. All API keys MUST start with VITE_ to be available in client-side code
# 2. Never commit actual values to Git
# 3. Never share .env files
# 4. Rotate keys if accidentally exposed
# 5. Use environment-specific .env files when needed
